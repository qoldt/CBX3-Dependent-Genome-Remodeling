# macOS
.DS_Store

# R
.Rhistory
.RData
.Rproj.user/

# Generated analysis outputs — regenerable from the bigWigs + peaks + annotation
# by run_MINUTE.R, so none are committed (the .rds are tens of MB each). Only
# MINUTE_3 can run off a committed handoff; every other stage re-reads bigWigs
# anyway, so tracking the .rds bought little and cost repo size.
ChIP/results/counts/
ChIP/results/tables/
ChIP/results/figures/
ChIP/results/bed/
ChIP/results/rds/
# alternate output trees from MINUTE_RESULTS=... sensitivity runs (regenerable)
ChIP/results_*/

# Large raw inputs — downloaded from Google Drive (see ChIP/README.md), never
# committed. Peaks (ChIP/data/peaks) ARE committed. Default download targets:
ChIP/data/bigwig/
ChIP/data/annotation/
# Belt-and-suspenders in case MINUTE_DATA points somewhere else in the tree:
bigwig/
*.bw
LINE.mm39.bed
SINE.mm39.bed
LTR.mm39.bed
TAD_boundaries_mm39.bed

# GAM raw data — ~7.7 GB of NPMI matrices, differential contacts and hotspot
# tracks, delivered from the GAM processing pipeline, never committed. Same rule
# as the ChIP bigWigs: large, externally produced, not regenerable from this repo.
GAM/NPMI_matrices/
GAM/Diff_contacts/
GAM/Hotspots/
# GAM analysis outputs — regenerable by run_GAM.R from the data above. The
# hand-written results/*.md (METHODS etc.) ARE committed, so ignore only the
# generated subfolders, matching the ChIP/results rule above.
GAM/results/counts/
GAM/results/rds/
GAM/results/tables/
GAM/results/figures/
GAM/results/bed/
GAM/results_*/

# stray base-R plot device output
Rplots.pdf
